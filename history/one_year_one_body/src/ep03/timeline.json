37], ["C", 0.289], ["X", 0.0], ["X", 0.0], ["X", 0.107], ["A", 0.375], ["A", 0.615], ["A", 0.629], ["A", 0.612], ["S", 0.66], ["S", 0.604], ["O", 0.383], ["O", 0.21], ["O", 0.245], ["A", 0.211], ["A", 0.225], ["C", 0.221], ["C", 0.164], ["E", 0.141], ["E", 0.126], ["X", 0.0], ["X", 0.0], ["X", 0.0], ["X", 0.0]]}]}, {"id": "s36_pike", "ch": 6, "start": 10921, "end": 10998, "lines": [{"sp": "PIKE", "text": "Well. I'll be.", "start": 10939, "end": 10968, "t0": 364.633, "t1": 365.611, "vis": [["O", 0.462], ["O", 0.808], ["O", 0.97], ["O", 1.0], ["E", 0.971], ["E", 0.873], ["E", 0.807], ["E", 0.74], ["C", 0.59], ["C", 0.535], ["A", 0.634], ["A", 0.777], ["A", 0.865], ["A", 0.915], ["A", 0.863], ["E", 0.794], ["E", 0.667], ["E", 0.748], ["C", 0.925], ["C", 0.904], ["C", 0.794], ["M", 0.0], ["M", 0.0], ["M", 0.0], ["E", 0.504], ["E", 0.47], ["E", 0.409], ["E", 0.291], ["E", 0.145], ["X", 0.0]]}]}, {"id": "s37_goahead", "ch": 6, "start": 10998, "end": 11227, "lines": [{"sp": "NED", "text": "Suppose we work without batteries while we are affected by this trouble.", "start": 10998, "end": 11099, "t0": 366.6, "t1": 369.982, "vis": [["S", 0.26], ["A", 0.474], ["A", 0.666], ["A", 0.821], ["M", 0.0], ["O", 0.322], ["O", 0.64], ["O", 0.935], ["O", 0.972], ["O", 0.899], ["O", 0.851], ["O", 0.837], ["O", 0.613], ["E", 0.396], ["E", 0.587], ["E", 0.902], ["E", 0.942], ["O", 0.82], ["O", 0.714], ["A", 0.854], ["A", 0.964], ["A", 0.835], ["A", 0.422], ["O", 0.123], ["O", 0.237], ["O", 0.703], ["E", 0.754], ["E", 0.656], ["E", 0.896], ["A", 0.94], ["A", 0.692], ["A", 0.355], ["O", 0.265], ["O", 0.298], ["O", 0.658], ["M", 0.0], ["M", 0.0], ["A", 0.856], ["A", 0.762], ["A", 0.683], ["E", 0.718], ["E", 0.604], ["E", 0.517], ["E", 0.499], ["O", 0.473], ["O", 0.448], ["A", 0.432], ["A", 0.486], ["A", 0.382], ["A", 0.183], ["X", 0.0], ["X", 0.0], ["X", 0.0], ["X", 0.173], ["X", 0.701], ["O", 0.952], ["O", 0.916], ["O", 0.86], ["E", 0.945], ["E", 0.926], ["E", 0.852], ["A", 0.85], ["A", 0.848], ["A", 0.788], ["A", 0.596], ["A", 0.325], ["A", 0.128], ["X", 0.0], ["X", 0.277], ["F", 0.788], ["E", 0.758], ["E", 0.353], ["X", 0.0], ["C", 0.133], ["C", 0.461], ["C", 0.751], ["C", 0.66], ["C", 0.453], ["M", 0.0], ["A", 0.763], ["A", 0.778], ["E", 0.687], ["E", 0.601], ["E", 0.505], ["E", 0.573], ["E", 0.615], ["E", 0.525], ["S", 0.429], ["S", 0.229], ["C", 0.12], ["C", 0.181], ["C", 0.33], ["A", 0.798], ["A", 0.794], ["M", 0.0], ["A", 0.215], ["A", 0.243], ["A", 0.221], ["A", 0.137], ["X", 0.0], ["X", 0.0], ["X", 0.0]]}, {"sp": "PORTLAND", "text": "Very well. Shall I go ahead with business?", "start": 11109, "end": 11178, "t0": 370.302, "t1": 372.585, "vis": [["X", 0.0], ["F", 0.28], ["F", 0.738], ["E", 0.968], ["E", 0.99], ["C", 0.979], ["C", 0.993], ["E", 1.0], ["E", 0.996], ["O", 0.908], ["O", 0.647], ["O", 0.532], ["E", 0.734], ["E", 0.949], ["E", 0.98], ["E", 0.858], ["S", 0.594], ["S", 0.338], ["A", 0.194], ["A", 0.104], ["X", 0.0], ["X", 0.0], ["X", 0.0], ["C", 0.158], ["C", 0.27], ["A", 0.407], ["A", 0.568], ["A", 0.619], ["E", 0.657], ["E", 0.604], ["C", 0.488], ["C", 0.286], ["O", 0.184], ["O", 0.445], ["O", 0.735], ["O", 0.778], ["O", 0.75], ["A", 0.703], ["A", 0.583], ["A", 0.425], ["A", 0.291], ["E", 0.303], ["E", 0.476], ["E", 0.518], ["C", 0.336], ["C", 0.258], ["O", 0.303], ["O", 0.292], ["O", 0.12], ["X", 0.0], ["X", 0.0], ["X", 0.0], ["E", 0.132], ["E", 0.517], ["E", 0.625], ["M", 0.0], ["M", 0.0], ["E", 0.273], ["E", 0.166], ["E", 0.166], ["E", 0.133], ["X", 0.0], ["C", 0.1], ["C", 0.175], ["A", 0.239], ["A", 0.223], ["S", 0.185], ["S", 0.105], ["X", 0.0]]}, {"sp": "NED", "text": "Yes. Go ahead.", "start": 11187, "end": 11222, "t0": 372.905, "t1": 374.06, "vis": [["E", 0.274], ["E", 0.682], ["E", 0.939], ["E", 0.982], ["E", 0.919], ["E", 0.847], ["E", 0.792], ["E", 0.649], ["S", 0.483], ["S", 0.376], ["C", 0.301], ["C", 0.226], ["C", 0.368], ["O", 0.843], ["O", 0.969], ["O", 0.861], ["O", 0.795], ["O", 0.798], ["O", 0.735], ["O", 0.637], ["A", 0.615], ["A", 0.84], ["A", 0.903], ["A", 0.778], ["C", 0.672], ["C", 0.539], ["C", 0.383], ["E", 0.29], ["E", 0.319], ["E", 0.321], ["E", 0.321], ["C", 0.257], ["C", 0.145], ["X", 0.0], ["X", 0.0]]}]}, {"id": "s38_hours", "ch": 6, "start": 11227, "end": 11447, "lines": [{"sp": "N", "text": "And they did. For about two hours, Boston and Portland traded messages powered by nothing but the storm.", "start": 11227, "end": 11441, "t0": 374.233, "t1": 381.382}]}, {"id": "s39_after", "ch": 6, "start": 11447, "end": 11655, "lines": [{"sp": "N", "text": "The next day, some lines were still being worked for a while by what people called atmospheric current alone.", "start": 11447, "end": 11650, "t0": 381.567, "t1": 388.331}]}, {"id": "s39b_secret", "ch": 6, "start": 11655, "end": 11774, "lines": [{"sp": "PIKE", "text": "Barlow. Not a word to head office that we unplugged it.", "start": 11655, "end": 11734, "t0": 388.5, "t1": 391.142, "vis": [["M", 0.0], ["M", 0.0], ["A", 0.921], ["A", 1.0], ["A", 1.0], ["C", 1.0], ["C", 0.991], ["C", 0.916], ["O", 0.771], ["O", 0.755], ["O", 0.808], ["O", 0.774], ["O", 0.735], ["C", 0.701], ["C", 0.698], ["A", 0.74], ["A", 0.784], ["A", 0.839], ["A", 0.844], ["A", 0.769], ["A", 0.733], ["O", 0.766], ["O", 0.825], ["O", 0.756], ["A", 0.724], ["A", 0.869], ["A", 0.979], ["C", 0.948], ["C", 0.734], ["C", 0.49], ["A", 0.42], ["A", 0.597], ["A", 0.804], ["C", 0.663], ["C", 0.505], ["E", 0.693], ["E", 0.853], ["C", 0.78], ["C", 0.664], ["A", 0.788], ["A", 0.799], ["A", 0.74], ["F", 0.69], ["F", 0.641], ["E", 0.522], ["E", 0.269], ["S", 0.155], ["S", 0.293], ["S", 0.507], ["S", 0.562], ["A", 0.444], ["A", 0.207], ["C", 0.179], ["C", 0.495], ["O", 0.507], ["O", 0.423], ["E", 0.586], ["E", 0.872], ["E", 0.971], ["E", 0.913], ["A", 0.815], ["A", 0.782], ["C", 0.747], ["C", 0.553], ["M", 0.0], ["C", 0.143], ["C", 0.257], ["A", 0.699], ["A", 0.828], ["A", 0.725], ["C", 0.555], ["C", 0.385], ["C", 0.288], ["E", 0.361], ["E", 0.27], ["E", 0.114], ["X", 0.0], ["X", 0.118], ["X", 0.0], ["X", 0.0]]}, {"sp": "NED", "text": "No, sir.", "start": 11744, "end": 11768, "t0": 391.462, "t1": 392.277, "vis": [["C", 0.423], ["C", 0.871], ["C", 0.999], ["O", 0.997], ["O", 0.982], ["O", 0.954], ["O", 0.897], ["O", 0.813], ["O", 0.768], ["O", 0.7], ["O", 0.518], ["O", 0.397], ["O", 0.349], ["O", 0.309], ["S", 0.37], ["S", 0.688], ["S", 0.749], ["A", 0.71], ["A", 0.645], ["A", 0.6], ["A", 0.519], ["A", 0.365], ["A", 0.247], ["A", 0.111], ["X", 0.0]]}]}, {"id": "s40_swallow", "ch": 7, "start": 11774, "end": 12053, "lines": [{"sp": "N", "text": "Carrington suspected that the flash he saw and the storm were connected. But he was careful. One swallow, he wrote, does not make a summer.", "start": 11774, "end": 12048, "t0": 392.467, "t1": 401.6}]}, {"id": "s41_loomis", "ch": 7, "start": 12053, "end": 12362, "lines": [{"sp": "N", "text": "In America, the Yale professor Elias Loomis gathered reports from around the world, and published them in nine articles over the next three years.", "start": 12053, "end": 12356, "t0": 401.767, "t1": 411.875}]}, {"id": "s42_name", "ch": 7, "start": 12362, "end": 12583, "lines": [{"sp": "N", "text": "Today it is called the Carrington Event: the most intense geomagnetic storm in recorded history.", "start": 12362, "end": 12577, "t0": 412.067, "t1": 419.241}]}, {"id": "s42b_aurora", "ch": 7, "start": 12583, "end": 13052, "lines": [{"sp": "N", "text": "What you saw that night was the storm hitting the air itself. Charged particles slam into the upper atmosphere, and oxygen glows: green lower down, deep red higher up. In a storm this strong, the glow spreads far from the poles.", "start": 12583, "end": 13047, "t0": 419.433, "t1": 434.885}]}, {"id": "s43_today", "ch": 7, "start": 13052, "end": 13458, "lines": [{"sp": "N", "text": "In eighteen fifty-nine, the worst it could do was shock a few operators and burn some paper. Today we run almost everything on wires. Power grids. Satellites. Navigation. The internet.", "start": 13052, "end": 13452, "t0": 435.067, "t1": 448.415}]}, {"id": "s44_2012", "ch": 7, "start": 13458, "end": 13714, "lines": [{"sp": "N", "text": "In July twenty twelve, the sun threw out a storm thought to be of similar strength. It missed the Earth by about nine days.", "start": 13458, "end": 13708, "t0": 448.6, "t1": 456.939}]}, {"id": "s44b_quebec", "ch": 7, "start": 13714, "end": 14133, "lines": [{"sp": "N", "text": "And smaller storms have already done real damage. In March nineteen eighty-nine, one knocked out the power grid of Quebec, in Canada, leaving about six million people in the dark for around nine hours.", "start": 13714, "end": 14128, "t0": 457.133, "t1": 470.922}]}, {"id": "s45_cost", "ch": 7, "start": 14133, "end": 14577, "lines": [{"sp": "N", "text": "A twenty thirteen study for the insurer Lloyd's of London estimated that a storm like eighteen fifty-nine's could cost the United States alone between six hundred billion and two point six trillion dollars.", "start": 14133, "end": 14571, "t0": 471.1, "t1": 485.709}]}, {"id": "s46_2024", "ch": 7, "start": 14577, "end": 14856, "lines": [{"sp": "N", "text": "And in May twenty twenty-four, a far weaker storm brought the northern lights to skies far to the south, where most people had never seen them.", "start": 14577, "end": 14851, "t0": 485.9, "t1": 495.029}]}, {"id": "s47_home", "ch": 8, "start": 14856, "end": 15107, "lines": [{"sp": "N", "text": "And you? Your shift finally ends. You walk home through streets still full of people talking about the night the sky caught fire.", "start": 14856, "end": 15101, "t0": 495.2, "t1": 503.383}]}, {"id": "s48_question", "ch": 8, "start": 15107, "end": 15414, "lines": [{"sp": "N", "text": "So, tell me. If the sky turned red tonight, and every screen went dead, what would you do first?", "start": 15107, "end": 15303, "t0": 503.567, "t1": 510.098}, {"sp": "NED", "text": "Unplug the battery.", "start": 15313, "end": 15350, "t0": 510.418, "t1": 511.668, "vis": [["A", 0.574], ["A", 0.901], ["A", 0.892], ["A", 0.825], ["C", 0.697], ["C", 0.387], ["M", 0.0], ["M", 0.0], ["M", 0.0], ["C", 0.828], ["C", 0.97], ["A", 0.839], ["A", 0.634], ["A", 0.485], ["A", 0.523], ["C", 0.616], ["C", 0.85], ["S", 0.787], ["S", 0.575], ["S", 0.692], ["A", 0.909], ["A", 0.876], ["A", 0.783], ["A", 0.757], ["M", 0.0], ["M", 0.0], ["A", 0.622], ["A", 0.556], ["A", 0.473], ["A", 0.419], ["C", 0.394], ["C", 0.349], ["E", 0.328], ["E", 0.285], ["E", 0.251], ["E", 0.194], ["X", 0.0], ["X", 0.0]]}, {"sp": "PIKE", "text": "Make coffee.", "start": 15360, "end": 15385, "t0": 511.988, "t1": 512.834, "vis": [["M", 0.0], ["M", 0.0], ["E", 0.985], ["E", 1.0], ["E", 0.99], ["E", 0.908], ["E", 0.704], ["E", 0.511], ["E", 0.329], ["E", 0.209], ["C", 0.418], ["C", 0.748], ["C", 0.922], ["C", 0.91], ["O", 0.907], ["O", 0.848], ["O", 0.654], ["O", 0.39], ["F", 0.237], ["F", 0.376], ["E", 0.476], ["E", 0.388], ["E", 0.289], ["E", 0.203], ["X", 0.0], ["X", 0.0]]}]}, {"id": "s49_end", "ch": 8, "start": 15414, "end": 15779, "lines": []}], "chapters": {"1": "The Sky Is On Fire", "2": "The Night Wire", "3": "The Man Who Watched the Sun", "4": "Red Sky at Midnight", "5": "The Wire Catches Fire", "6": "Unplug the Battery", "7": "What Was It?", "8": "The Night the Sky Caught Fire"}}