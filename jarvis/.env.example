# Bu dosyayı ".env" olarak kopyalayın ve anahtarınızı yazın.
# Anahtar: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Opsiyonel ayarlar
JARVIS_USER_NAME=efendim
# guvenli | akilli | tam
JARVIS_MODE=akilli
JARVIS_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
JARVIS_EFFORT=high
